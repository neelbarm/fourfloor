# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# audio: WAVs are large and regenerable. fixtures/ is the only committed audio,
# plus the demo mp3/session/plan/preview under examples/.
*.wav
!fixtures/*.wav
*.flac
*.aiff

# private material: never commit source songs, reference remixes, or anything
# derived from them
scratch/
private/
styles/learned.json
*.house.wav
*.session.wav
# a learned profile without --anonymous names every reference file it read;
# only the anonymised aggregates below are committed
style.json
styles/*.json
!styles/klickaud-refs.json
!styles/pairs.json
# remixes rendered from inside the repo (the committed demo is already tracked)
*.house.mp3
*.house.session.json
*.house.plan.json
*.house.batch.json
*.preview.html

# os
.DS_Store
